{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-aksara-sunda",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "aksarasunda.my.id/*",
      "zone_name": "aksarasunda.my.id"
    }
  ],
  "main": "src/server.ts",
}
